# Environment Configuration for Royal Bull Capital Backend
PORT=8000
HOST=0.0.0.0

# Database Connection (PostgreSQL or SQLite fallback)
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/royalbull
# Local fallback (SQLite):
DATABASE_URL=sqlite:///./royal_bull_capital.db

# Security & Tokens
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_TO_A_64_CHARACTER_RANDOM_HEX_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Initial Admin Bootstrap (Set during first deployment)
INITIAL_ADMIN_PASSWORD=Admin123!

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
